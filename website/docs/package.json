{
  "name": "atoo-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Atoo user documentation: Astro + Starlight. Deploys to docs.atoo.app via Cloudflare Workers.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:staging": "astro build --mode staging",
    "preview": "astro preview",
    "check-links": "python3 tools/check_links.py dist",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "wrangler": "^4.130.0"
  }
}
